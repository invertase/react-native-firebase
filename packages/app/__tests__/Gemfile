# frozen_string_literal: true

source 'https://rubygems.org'

# Coverage for `yarn tests:ios:ruby` (see run_with_coverage.rb).
# Do not pin minitest here — suites use the environment's minitest (bare ruby /
# cocoapods may already activate one). Opt-in shape/embed suites may still
# `require` system cocoapods/xcodeproj; the runner avoids Bundler isolation so
# those system gems remain visible when installed (e.g. tests_e2e_ios.yml).
#
# Supply-chain notes (Bundler 2.6.x host):
# - Commit Gemfile.lock (with CHECKSUMS via `bundle lock --add-checksums`).
# - CI uses `BUNDLE_FROZEN=true bundle install` so lock drift fails the job
#   (Bundler 2.6 deprecates `--frozen` and would persist it into .bundle/config).
# - Do NOT put Bundler-native `cooldown:` here — that needs Bundler 4.0.13+.
#   Dependabot cooldown for this directory lives in `.github/dependabot.yml`.
gem 'simplecov', '~> 1.0'
gem 'simplecov-lcov', '~> 0.9'
