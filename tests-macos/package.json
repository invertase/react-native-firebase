{
  "name": "react-native-firebase-tests-macos",
  "version": "26.2.0",
  "private": true,
  "scripts": {
    "build:clean": "rimraf macos/build",
    "build:macos": "bash -c 'set -o pipefail && export TOOLCHAINS=\"${TOOLCHAINS:-com.apple.dt.toolchain.XcodeDefault}\" && PRODUCT_NAME=${RNFB_MACOS_PRODUCT_NAME:-io.invertase.testing} && case \"$PRODUCT_NAME\" in io.invertase.testing) SUFFIX= ;; io.invertase.testing.*) SUFFIX=${PRODUCT_NAME#io.invertase.testing} ;; *) echo \"error: RNFB_MACOS_PRODUCT_NAME must be io.invertase.testing or io.invertase.testing.<slot> (got $PRODUCT_NAME)\" >&2; exit 1 ;; esac && export RNFB_MACOS_PRODUCT_NAME_SUFFIX=\"$SUFFIX\" && echo \"[rnfb-e2e] macos build PRODUCT_NAME=$PRODUCT_NAME (suffix=${SUFFIX:-<none>})\" && RCT_METRO_PORT=${RCT_METRO_PORT:-8081} xcodebuild CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ -workspace macos/io.invertase.testing.xcworkspace -scheme io.invertase.testing-macOS -configuration Debug -derivedDataPath macos/build | xcbeautify'",
    "prepare": "patch-package"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-async-storage/async-storage": "^2.0.2",
    "@react-native-community/cli": "15.1.3",
    "@react-native-community/cli-platform-ios": "15.1.3",
    "@react-native-firebase/ai": "26.2.0",
    "@react-native-firebase/analytics": "26.2.0",
    "@react-native-firebase/app": "26.2.0",
    "@react-native-firebase/app-check": "26.2.0",
    "@react-native-firebase/app-distribution": "26.2.0",
    "@react-native-firebase/app-types": "6.7.2",
    "@react-native-firebase/auth": "26.2.0",
    "@react-native-firebase/crashlytics": "26.2.0",
    "@react-native-firebase/database": "26.2.0",
    "@react-native-firebase/firestore": "26.2.0",
    "@react-native-firebase/functions": "26.2.0",
    "@react-native-firebase/in-app-messaging": "26.2.0",
    "@react-native-firebase/installations": "26.2.0",
    "@react-native-firebase/messaging": "26.2.0",
    "@react-native-firebase/ml": "26.2.0",
    "@react-native-firebase/perf": "26.2.0",
    "@react-native-firebase/phone-number-verification": "26.2.0",
    "@react-native-firebase/remote-config": "26.2.0",
    "@react-native-firebase/storage": "26.2.0",
    "postinstall-postinstall": "2.1.0",
    "prop-types": "^15.8.1",
    "react": "19.0.0",
    "react-native": "0.78.3",
    "react-native-macos": "0.78.6",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.78.3",
    "@react-native/metro-config": "^0.78.3",
    "assert": "^2.1.0",
    "axios": "^1.15.2",
    "babel-plugin-istanbul": "^7.0.1",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "firebase": "^12.17.1",
    "jet": "patch:jet@npm%3A0.9.0-dev.13#~/.yarn/patches/jet-npm-0.9.0-dev.13-3321aeea6e.patch",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "patch-package": "^8.0.1",
    "rimraf": "^6.1.3",
    "should": "^13.2.3",
    "should-sinon": "0.0.6",
    "sinon": "21.1.2"
  },
  "nx": {
    "targets": {
      "prepare": {
        "cache": false
      }
    }
  }
}
