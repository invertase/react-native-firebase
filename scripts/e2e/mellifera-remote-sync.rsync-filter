# Default rsync merge filter for remote source sync.
# Pass --filter FILE to replace this list for one run.
# Dependencies and build output are omitted. The remote install recreates them.
# Version-control metadata is omitted; the remote tree is a source copy.
# `.git` has no trailing slash so a worktree's `.git` file is omitted too.
# Mellifera session and reserve state (gitignored) holds grant tokens. The sync
# script also passes these as --exclude ahead of any --filter FILE. Each is
# anchored at the checkout root; the bare name also matches a symlink.

- /tests/mellifera-distributed
- /tests/mellifera-distributed/
- /tests/mellifera-platform
- /tests/mellifera-platform/
- /tests/mellifera.env.json
- /tests/mellifera.env.json/
- /tests/.mellifera-session.env
- /tests/.mellifera-session.env/

# The e2e run record names this machine's processes. The sync script also
# passes these as --exclude ahead of any --filter FILE.
- /.e2e-run
- /.e2e-run/

# Local agent reports and queues, which may keep copies of reserve JSON.
- /.agents/reports/
- /.agents/work-queues/

- node_modules/
- .git
- .nx/
- .yarn/cache/
- .yarn/unplugged/
- Pods/
- vendor/bundle/
- build/
- dist/
- .cxx/
- *.apk
- *.log
